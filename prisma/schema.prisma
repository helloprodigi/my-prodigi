generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  date        DateTime
  category    String
  excerpt     String
  coverImage  String
  contentHtml String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExecutiveMember {
  id        Int      @id @default(autoincrement())
  year      String
  name      String
  nim       String
  prodi     String
  angkatan  String
  position  String
  linkedin  String?
  instagram String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nim, year])
}

model HallOfFame {
  id          Int      @id @default(autoincrement())
  year        String
  title       String
  competition String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  year        String
  fileName    String
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdmissionResult {
  id        Int      @id @default(autoincrement())
  nim       String   @unique
  name      String
  position  String
  isPassed  Boolean  @map("lolos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String   @id // Mapping to Supabase auth.users id
  email       String   @unique
  name        String?
  nim         String?
  jurusan     String?
  angkatan    String?
  nomorWa     String?
  cvUrl       String?
  photoUrl    String?
  skills      String[]
  interests   String[]
  role        String   @default("talent") // Can be "talent", "asisten_lab", "admin"
  isOnboarded Boolean  @default(false)
  jabatan     String?
  divisi      String?
  hasProkerAccess Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  competitionsCreated Competition[]  @relation("CreatedCompetitions")
  draftCompetitionsCreated DraftCompetition[] @relation("DraftCompetitionCreatedBy")
  teamsAsLeader       Team[]         @relation("UserLedTeams")
  teamMemberships     TeamMember[]   @relation("UserTeamMemberships")
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  programKerjaCreated ProgramKerja[] @relation("ProgramKerjaCreatedBy")
  laporanCreated      Laporan[]      @relation("LaporanCreatedBy")
  
  absensiAgendaCreated AbsensiAgenda[] @relation("AbsensiAgendaCreatedBy")
  shiftAssignments     ShiftAssignment[] @relation("UserShiftAssignments")
  absensiRecords       AbsensiRecord[]   @relation("UserAbsensiRecords")
}

model Competition {
  id          String   @id @default(uuid())
  title       String
  organizer   String
  deadline    DateTime
  category    String   // e.g., "Belmawa", "Non-Belmawa", "Internal"
  skills      String[] // Tags e.g., ["Data Science", "UI/UX Design"]
  imageUrl    String?
  description String?
  link        String?
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdById String?
  createdBy   User?    @relation("CreatedCompetitions", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]    @relation("CompetitionTeams")
}

model DraftCompetition {
  id          String   @id @default(uuid())
  title       String
  organizer   String
  tab         String   // Guidebook, Proposal, Pitch Deck
  category    String?  // Belmawa, Non-Belmawa, Internal
  skills      String[]
  description String?
  link        String?
  createdById String?
  createdBy   User?     @relation("DraftCompetitionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tab])
}

model Team {
  id                 String   @id @default(uuid())
  name               String
  memberCount        Int
  competitionId      String
  competition        Competition @relation("CompetitionTeams", fields: [competitionId], references: [id], onDelete: Cascade)
  leaderId           String?  
  leader             User?    @relation("UserLedTeams", fields: [leaderId], references: [id])
  requiredSkills     String[] 
  link               String
  category           String
  status             String   @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members            TeamMember[]
}

model TeamMember {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserTeamMemberships", fields: [userId], references: [id])
  status      String   @default("WAITING") // "WAITING", "APPROVED"
  slotNumber  Int?
  inviteToken String?
  invitedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "team_approve", "team_reject", "competition_new", "custom_info"
  title       String
  description String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgramKerja {
  id             String   @id @default(uuid())
  divisi         String   // matches the `name` field in lib/divisions.ts
  nama           String
  deskripsi      String?
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  status         String   @default("BELUM_SELESAI") // "BELUM_SELESAI", "SELESAI"
  createdById    String?
  createdBy      User?    @relation("ProgramKerjaCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  laporan        Laporan[]
}

model Laporan {
  id             String   @id @default(uuid())
  programKerjaId String
  programKerja   ProgramKerja @relation(fields: [programKerjaId], references: [id], onDelete: Cascade)
  catatan        String?
  fileUrl        String
  createdById    String?
  createdBy      User?    @relation("LaporanCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AbsensiAgenda {
  id           String   @id @default(uuid())
  nama         String
  deskripsi    String?
  divisi       String
  waktuMulai   DateTime
  waktuSelesai DateTime
  kodeQrDatang String?  // Optional token for attendance check-in
  kodeQrPulang String?  // Optional token for attendance check-out
  createdAt    DateTime @default(now())
  
  createdById  String?
  createdBy    User?    @relation("AbsensiAgendaCreatedBy", fields: [createdById], references: [id])
  
  assignedUsers ShiftAssignment[] 
  records       AbsensiRecord[]
}

model ShiftAssignment {
  id          String        @id @default(uuid())
  agendaId    String
  agenda      AbsensiAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation("UserShiftAssignments", fields: [userId], references: [id])
  nama        String
  nim         String
  
  @@unique([agendaId, nim])
}

model AbsensiRecord {
  id             String        @id @default(uuid())
  agendaId       String
  agenda         AbsensiAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation("UserAbsensiRecords", fields: [userId], references: [id])
  nama           String?
  nim            String?
  waktuDatang    DateTime?
  waktuPulang    DateTime?
  status         String        @default("ALPA") // "HADIR", "ALPA", "IZIN"
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([agendaId, userId])
}
